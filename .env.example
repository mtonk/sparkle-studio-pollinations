# Copy this file to .env and fill in your values
# This app only uses Pollinations.ai models.

# Optional: server-to-server key for vision (sketch descriptions).
# Without it, users must BYOP (Bring Your Own Pollen) for vision.
POLLINATIONS_API_KEY=

# Optional: set a password for the whole app (icons and manifest stay public)
APP_PASSWORD=

PORT=3000
SESSION_SECRET=
