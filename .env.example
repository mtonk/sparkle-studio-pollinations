# Copy this file to .env and fill in your values
# This app only uses Pollinations.ai models.

# Optional Pollinations key. NOTE: the web server does NOT use this on any
# request path — vision and premium image generation use each logged-in user's
# own (BYOP) session key, and free image generation uses no key at all. This var
# is read only by the helper scripts (scripts/claim-pollen.js, test-vision.js).
POLLINATIONS_API_KEY=

# Optional: set a password for the whole app (icons and manifest stay public)
APP_PASSWORD=

PORT=3000

# Signs session cookies. REQUIRED for any real deployment — if left empty the
# server generates a random secret at startup and all sessions reset on restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed behind HTTPS. Enables Secure cookies and
# trusts the X-Forwarded-* headers from your TLS-terminating proxy.
NODE_ENV=
